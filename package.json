{
  "name": "tree-sitter-graphcal",
  "version": "0.5.0",
  "description": "Tree-sitter grammar for Graphcal (.gcl)",
  "keywords": [
    "graphcal",
    "parser",
    "tree-sitter"
  ],
  "license": "MIT",
  "main": "bindings/node",
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse"
  },
  "dependencies": {
    "nan": "^2.20.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.26.13"
  },
  "tree-sitter": [
    {
      "scope": "source.graphcal",
      "file-types": [
        "gcl"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^(graphcal|gcl)$"
    }
  ]
}
